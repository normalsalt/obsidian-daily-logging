{
	"permissions": {
		"allow": [
			"Bash(npm run lint)",
			"Bash(npm run lint -- --fix)",
			"Bash(npx eslint . --fix)",
			"Bash(npm run build)"
		],
		"ask": ["Bash(git commit *)"],
		"deny": [
			"Bash(git push *)",
			"Bash(git tag *)",
			"Bash(git reset --hard *)",
			"Bash(npm version *)",
			"Bash(npm audit fix *)",
			"Bash(gh release *)"
		]
	}
}
