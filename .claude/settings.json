{
	"permissions": {
		"allow": [
			"Bash(npm run lint)",
			"Bash(npm run lint -- --fix)",
			"Bash(npx eslint . --fix)",
			"Bash(npm run build)",
			"Bash(obsidian dev:debug on)",
			"Bash(obsidian plugin:reload id=daily-logging)",
			"Bash(obsidian dev:errors)",
			"Bash(obsidian dev:errors clear)",
			"Bash(obsidian dev:console clear)",
			"Bash(obsidian dev:console level=error)"
		],
		"ask": ["Bash(git commit *)"],
		"deny": [
			"Bash(git push *)",
			"Bash(git tag *)",
			"Bash(git reset --hard *)",
			"Bash(npm version *)",
			"Bash(npm audit fix *)",
			"Bash(gh release *)"
		]
	}
}
